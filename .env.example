# Local development settings
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
# Yalnızca ana domain ve tüm alt domainler kalıcı HTTPS kullanıyorsa True bırakın.
DJANGO_SECURE_HSTS_PRELOAD=True
# Bu sürüm bilinçli olarak SQLite kullanır. Göreli yollar proje köküne göre çözülür.
SQLITE_DATABASE_PATH=db.sqlite3
SQLITE_TIMEOUT_SECONDS=20

# Redis / Celery (development uses in-memory eager mode when blank)
REDIS_URL=
TRUSTED_PROXY_IPS=127.0.0.1,::1
DJANGO_SESSION_COOKIE_AGE=28800
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=True
ANALYTICS_RETENTION_DAYS=180

# S3-compatible media storage
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# Observability and integrations
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Gmail SMTP: Google hesabında 2 Adımlı Doğrulama'yı açıp bir Uygulama Şifresi üretin.
# Normal Gmail parolanızı EMAIL_HOST_PASSWORD alanına yazmayın.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=hesabiniz@gmail.com
EMAIL_HOST_PASSWORD=16_haneli_uygulama_sifresi
DEFAULT_FROM_EMAIL=BST Akademi <hesabiniz@gmail.com>

# Optional Gemini integration
GEMINI_API_KEY=
GEMINI_WRITING_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash
